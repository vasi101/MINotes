{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Mi Notes",
    "version":  "0.1.3",
    "identifier":  "com.minotes.desktop",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Mi Notes",
                                    "width":  1280,
                                    "height":  900,
                                    "maximized":  true,
                                    "zoomHotkeysEnabled":  true,
                                    "minWidth":  768,
                                    "minHeight":  600,
                                    "decorations":  false,
                                    "backgroundColor":  "#000000"
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; script-src \u0027self\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 asset: http://asset.localhost blob: data:; font-src \u0027self\u0027 data:; connect-src \u0027self\u0027 ipc: http://ipc.localhost; worker-src \u0027self\u0027 blob:"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis",
                                   "msi"
                               ],
                   "icon":  [
                                "icons/icon.ico"
                            ]
               }
}
